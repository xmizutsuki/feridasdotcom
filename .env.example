# LOCAL DEVELOPMENT ONLY. Keep secrets and clinical photos outside Git.
# Generate values with: python -m app.security
FERIDAS_PASSWORD_HASH=
FERIDAS_SESSION_SECRET=
FERIDAS_IMAGE_KEY=
FERIDAS_STORAGE_DIR=./storage
# true only when serving HTTPS; mandatory in a real deployment
FERIDAS_COOKIE_SECURE=false
DATABASE_URL=sqlite:///./feridas_dev.db

# Experimental remote image analysis: OFF by default.
# Never enable with real patient images without explicit authorization, safeguards and review.
FERIDAS_REMOTE_IMAGE_ANALYSIS=false
FERIDAS_VISION_MODEL=
FERIDAS_OPENAI_API_KEY=
